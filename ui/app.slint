// brxswer chrome. Flat: no radius, no shadow, no gradient, 1px borders,
// one monospace size, 80ms colour snaps only.

import { Theme } from "theme.slint";
import { MenuWindow, MenuRow } from "menu.slint";
import { CardWindow, ToastWindow, PaletteWindow, PaletteRow } from "popups.slint";
import { HistoryView, HistRow, SettingsView, SetRow } from "pages.slint";
export { Theme, MenuWindow, MenuRow, CardWindow, ToastWindow, PaletteWindow, PaletteRow, HistRow, SetRow }

export struct TabItem { label: string, active: bool, loading: bool, pinned: bool, audio: bool, muted: bool, trimmed: bool, crashed: bool }
export struct LayerRow { letter: string, label: string, count: string }
export struct LogRow { letter: string, subject: string, detail: string }
export struct Suggestion { tag: string, text: string, note: string }

component Rule inherits Rectangle {
    background: Theme.bg3;
}

component Cell inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <color> fg: Theme.fg;
    in property <length> pad: 12px;
    in property <length> min-w: 32px;
    callback clicked;
    width: max(root.min-w, label.preferred-width + 2 * root.pad);
    background: root.active ? Theme.bg2 : (ta.has-hover && root.enabled ? Theme.bg1 : transparent);
    animate background { duration: 80ms; }
    label := Text {
        text: root.text;
        color: root.enabled ? root.fg : Theme.dim;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 1px stroke icon in a 32px bar cell (12x12 viewbox).
component IconCell inherits Rectangle {
    in property <string> commands;
    in property <bool> enabled: true;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    width: 32px;
    background: ta.has-hover && root.enabled ? Theme.bg1 : transparent;
    animate background { duration: 80ms; }
    Path {
        x: (parent.width - 12px) / 2;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.commands;
        stroke: root.enabled ? Theme.fg : Theme.dim;
        stroke-width: 1px;
        fill: transparent;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Window control: 46x32, glyph in a 10x10 viewbox. `hot` lets the OS drive
// hover for the maximize cell, whose events arrive as non-client messages.
component WinButton inherits Rectangle {
    in property <string> commands;
    in property <bool> danger;
    in property <bool> hot;
    in property <bool> show: true;
    in property <bool> window-active: true;
    callback clicked;
    property <bool> lit: (ta.has-hover || root.hot) && root.show;
    width: root.show ? 46px : 0px;
    clip: true;
    background: root.lit ? (root.danger ? Theme.bad : Theme.bg2) : transparent;
    animate background { duration: 80ms; }
    Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.commands;
        stroke: root.lit && root.danger ? Theme.bg0 : (root.window-active ? Theme.fg : Theme.mid);
        stroke-width: 1px;
        fill: transparent;
    }
    ta := TouchArea {
        enabled: root.show;
        clicked => { root.clicked(); }
    }
}

// A tab is a numbered cell, like a Hyprland workspace: the number is its
// shortcut, and only the active tab spends width on a title.
component TabCell inherits Rectangle {
    in property <TabItem> item;
    in property <bool> window-active: true;
    in property <bool> drop-before;
    in property <bool> lifted;
    callback clicked;
    callback close();
    callback mute();
    callback menu();
    callback hover(bool);
    callback drag-move(length);
    callback drag-end(length);
    callback geom(length, length);
    property <bool> hot: ta.has-hover;
    property <bool> hover-x: root.hot && !root.item.active && !root.item.pinned;
    property <bool> armed;
    property <bool> dragging;
    property <bool> was-drag;
    property <length> press-x;
    property <color> ink: root.item.crashed ? Theme.bad
        : root.item.active ? (root.window-active ? Theme.bg0 : Theme.fg)
        : root.item.pinned ? Theme.fg
        : root.item.trimmed ? Theme.dim : Theme.mid;
    width: row.preferred-width;
    // Slint skips changed-callbacks for first values, so report at creation too
    init => { root.geom(self.x, self.width); }
    changed x => { root.geom(self.x, self.width); }
    changed width => { root.geom(self.x, self.width); }
    changed hot => { root.hover(self.hot); }
    // the accent marks only the window that has the keyboard
    background: root.lifted ? transparent
        : root.item.active ? (root.window-active ? Theme.acc : Theme.bg3)
        : root.item.pinned ? Theme.bg2
        : root.hot ? Theme.bg1 : transparent;
    animate background { duration: 80ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.armed = true;
                root.dragging = false;
                root.was-drag = false;
                root.press-x = self.mouse-x;
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                if (root.dragging) {
                    root.drag-end(self.mouse-x);
                }
                root.armed = false;
                root.dragging = false;
            }
            if (e.button == PointerEventButton.middle && e.kind == PointerEventKind.up) {
                root.close();
            }
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu();
            }
        }
        moved => {
            if (root.armed && !root.dragging && (self.mouse-x - root.press-x > 6px || root.press-x - self.mouse-x > 6px)) {
                root.dragging = true;
                root.was-drag = true;
            }
            if (root.dragging) {
                root.drag-move(self.mouse-x);
            }
        }
        clicked => {
            if (!root.was-drag) {
                root.clicked();
            }
        }
    }
    row := HorizontalLayout {
        padding-left: 11px;
        padding-right: root.item.active && !root.item.pinned ? 6px : 11px;
        spacing: 6px;
        Rectangle {
            width: lbl.preferred-width;
            lbl := Text {
                text: root.item.label;
                color: root.ink;
                font-weight: root.item.active ? 700 : 400;
                vertical-alignment: center;
                opacity: root.hover-x ? 0 : 1;
            }
            // crashed: the number is struck through
            if root.item.crashed: Rectangle {
                y: parent.height / 2;
                height: 1px;
                background: Theme.bad;
            }
            // inactive tabs show a close glyph in place of the number on hover
            if root.hover-x: Rectangle {
                x: (parent.width - 16px) / 2;
                width: 16px;
                y: (parent.height - 16px) / 2;
                height: 16px;
                background: hx.has-hover ? Theme.bg3 : transparent;
                Path {
                    x: 4px; y: 4px; width: 8px; height: 8px;
                    viewbox-width: 8; viewbox-height: 8;
                    commands: "M0 0 L8 8 M8 0 L0 8";
                    stroke: Theme.fg; stroke-width: 1px; fill: transparent;
                }
                hx := TouchArea { clicked => { root.close(); } }
            }
        }
        if root.item.audio: Rectangle {
            width: 12px;
            Path {
                y: (parent.height - 11px) / 2;
                width: 11px; height: 11px;
                viewbox-width: 12; viewbox-height: 12;
                commands: root.item.muted ? "M1.5 4.5 L3.5 4.5 L6.5 2 L6.5 10 L3.5 7.5 L1.5 7.5 Z M8 4.5 L11 7.5 M11 4.5 L8 7.5" : "M1.5 4.5 L3.5 4.5 L6.5 2 L6.5 10 L3.5 7.5 L1.5 7.5 Z M8.5 4.2 Q9.6 6 8.5 7.8";
                stroke: snd.has-hover ? (root.item.active ? root.ink : Theme.fg) : root.ink;
                stroke-width: 1px; fill: transparent;
            }
            snd := TouchArea { clicked => { root.mute(); } }
        }
        if root.item.active && !root.item.pinned: Rectangle {
            width: 16px;
            y: (parent.height - 16px) / 2;
            height: 16px;
            background: ax.has-hover ? (root.window-active ? Theme.bg0 : Theme.bg2) : transparent;
            Path {
                x: 4px; y: 4px; width: 8px; height: 8px;
                viewbox-width: 8; viewbox-height: 8;
                commands: "M0 0 L8 8 M8 0 L0 8";
                stroke: ax.has-hover && root.window-active ? Theme.acc : root.ink;
                stroke-width: 1px; fill: transparent;
            }
            ax := TouchArea { clicked => { root.close(); } }
        }
    }
    // loading: 2px line along the bottom edge
    if root.item.loading: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.item.active ? Theme.mid : Theme.mid;
        opacity: root.item.active ? 0.6 : 1;
    }
    // where a dragged tab will land
    if root.drop-before: Rectangle {
        x: -1px;
        width: 2px;
        background: Theme.acc;
    }
    if root.lifted: Rectangle {
        border-width: 1px;
        border-color: Theme.acc;
    }
}

export component AppWindow inherits Window {
    in property <string> win-title: "brxswer";
    title: root.win-title;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 480px;
    min-height: 240px;
    background: Theme.bg0;
    default-font-family: Theme.font;
    default-font-size: 12px;

    // ----------------------------------------------------------- state in
    in property <[TabItem]> tabs;
    in-out property <string> address;
    in property <string> security;
    // idle address display: host in bold, the rest in grey
    in property <string> addr-host;
    in property <string> addr-rest;
    in property <bool> addr-puny;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> loading;
    in property <float> progress;
    in property <string> shield-count: "0";
    in property <bool> panel-open;
    in property <bool> shield-on: true;
    in property <string> panel-host;
    in property <[LayerRow]> layers;
    in property <[LogRow]> log;
    in property <string> session-line;
    in property <string> session-short;
    in property <string> footer-right;
    in property <[Suggestion]> suggestions;
    in property <string> strip-preview;
    in property <string> strip-note;
    in-out property <int> selected;
    in property <bool> blank: true;
    // internal page on the active tab: 0 none, 1 history, 2 settings
    in property <int> page;
    in property <[HistRow]> hist-rows;
    in property <string> hist-note;
    in-out property <string> hist-query;
    in property <[string]> set-sections;
    in property <int> set-section;
    in property <[SetRow]> set-rows;
    in property <[string]> theme-names;
    in property <[color]> theme-acc;
    in property <[color]> theme-bg;
    in property <[color]> theme-mid;
    in property <int> theme-index;
    // empty tab
    in property <[string]> recent;
    // ephemeral window: nothing is written to disk
    in property <bool> eph;
    // under 720px the chrome compacts instead of wrapping
    in property <bool> narrow;
    // title bar
    in property <bool> controls;
    in property <bool> zoomed;
    in property <bool> window-active: true;
    in property <bool> max-hot;
    in property <bool> menu-open;
    // tab strip
    in property <int> hidden-left;
    in property <int> hidden-right;
    in property <length> strip-scroll;
    // width of the whole cells in view; 0 = no clipping needed
    in property <length> strip-show;
    in property <int> drag-from: -1;
    in property <int> drop-at: -1;

    // ---------------------------------------------------------- events out
    callback submit(string);
    callback edited(string);
    callback tab-clicked(int);
    callback new-tab();
    callback back();
    callback forward();
    callback reload();
    callback toggle-panel();
    callback set-shield(bool);
    callback page-focus();
    callback complete(int);
    callback shortcut(string, bool, bool, bool) -> bool;
    callback geometry-changed();
    callback win-minimize();
    callback win-maximize();
    callback win-close();
    callback menu-toggle();
    callback tab-close(int);
    callback tab-mute(int);
    callback tab-menu(int);
    callback tab-hover(int, bool);
    callback tab-drag(int, length);
    callback tab-drop(int, length);
    callback tab-geom(int, length, length);
    callback strip-step(int);
    callback hist-search(string);
    callback hist-open(int);
    callback hist-forget(int);
    callback hist-clear();
    callback set-section-pick(int);
    callback set-value(string, string);
    callback set-theme-pick(int);
    callback reopen-recent(int);
    callback strip-wheel(length);

    // ----------------------------------------------------------- geometry
    property <length> bar-h: 33px;
    property <length> row-h: 29px;
    out property <bool> address-focused: addr.has-focus;
    property <bool> show-sugg: addr.has-focus && root.suggestions.length > 0;
    property <length> sugg-h: root.show-sugg ? (root.suggestions.length + (root.strip-preview != "" ? 1 : 0)) * root.row-h : 0px;
    property <length> footer-h: (root.blank || root.show-sugg) ? 25px : 0px;
    out property <length> content-y: root.bar-h + root.sugg-h;
    out property <length> content-w: root.width - (root.panel-open ? 361px : 0px);
    out property <length> content-h: max(0px, root.height - root.content-y - root.footer-h);
    changed content-y => { root.geometry-changed(); }
    changed content-w => { root.geometry-changed(); }
    changed content-h => { root.geometry-changed(); }

    // Regions the OS hit-tests: empty bar space drags the window, the
    // maximize cell answers as the native maximize button (snap layouts).
    out property <length> drag1-x: drag1.absolute-position.x;
    out property <length> drag1-w: drag1.width;
    out property <length> drag2-x: drag2.absolute-position.x;
    out property <length> drag2-w: drag2.width;
    out property <length> max-x: max-btn.absolute-position.x;
    out property <length> max-w: max-btn.width;
    out property <length> menu-btn-x: menu-btn.absolute-position.x;
    out property <length> menu-btn-w: menu-btn.width;
    out property <length> strip-x: strip.absolute-position.x;
    out property <length> strip-w: strip.width;
    // room the tab strip may take before it scrolls
    property <length> center-min: root.narrow ? 180px : 260px;
    changed drag1-x => { root.geometry-changed(); }
    changed drag2-x => { root.geometry-changed(); }
    changed drag2-w => { root.geometry-changed(); }

    public function focus-address() {
        addr.focus();
        addr.select-all();
    }

    // Keyboard focus moved into the page (a native child window).
    public function blur-address() {
        addr.clear-focus();
    }

    FocusScope {
        capture-key-pressed(e) => {
            if (e.modifiers.control || e.modifiers.alt || e.text == Key.F5) {
                if (root.shortcut(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift)) {
                    return accept;
                }
            }
            return reject;
        }

        // =============================================================== bar
        // One row that is also the title bar:
        //   tabs | drag | back fwd reload address | drag | status | window controls
        Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: 32px;
            HorizontalLayout {
                if root.eph: Rectangle {
                    width: eph-t.preferred-width + 20px;
                    background: Theme.acc;
                    eph-t := Text { text: "eph"; color: Theme.bg0; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
                }
                if root.eph: Rule { width: 1px; }
                if root.hidden-left > 0: Cell {
                    text: "‹ " + root.hidden-left;
                    fg: Theme.mid;
                    min-w: 48px;
                    clicked => { root.strip-step(-1); }
                }
                // the layout gives the strip what is left, up to the width of
                // its tabs; when that is not enough it scrolls (see strip.rs)
                strip := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 64px;
                    preferred-width: tabs-row.preferred-width;
                    max-width: tabs-row.preferred-width;
                    clip: true;
                    TouchArea {
                        scroll-event(e) => {
                            root.strip-wheel(e.delta-y + e.delta-x);
                            return accept;
                        }
                    }
                    // only whole cells are ever shown: a half-cut tab reads as a bug
                    Rectangle {
                    x: 0;
                    width: root.strip-show > 0 ? root.strip-show : parent.width;
                    clip: true;
                    tabs-row := HorizontalLayout {
                        x: -root.strip-scroll;
                        width: self.preferred-width;
                        for t[i] in root.tabs: TabCell {
                            item: t;
                            window-active: root.window-active;
                            lifted: i == root.drag-from;
                            drop-before: i == root.drop-at && root.drag-from >= 0;
                            clicked => { root.tab-clicked(i); }
                            close => { root.tab-close(i); }
                            mute => { root.tab-mute(i); }
                            menu => {
                                root.tab-geom(i, self.x, self.width);
                                root.tab-menu(i);
                            }
                            hover(on) => {
                                root.tab-geom(i, self.x, self.width);
                                root.tab-hover(i, on);
                            }
                            drag-move(x) => {
                                root.tab-geom(i, self.x, self.width);
                                root.tab-drag(i, x);
                            }
                            drag-end(x) => { root.tab-drop(i, x); }
                            geom(x, w) => { root.tab-geom(i, x, w); }
                        }
                    }
                    }
                }
                if root.hidden-right > 0: Cell {
                    text: root.hidden-right + " ›";
                    fg: Theme.mid;
                    min-w: 48px;
                    clicked => { root.strip-step(1); }
                }
                Rule { width: 1px; }
                Cell {
                    text: "+";
                    fg: Theme.mid;
                    pad: 11px;
                    clicked => { root.new-tab(); }
                }
                drag1 := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 16px;
                }
                Rule { width: 1px; }
                // grows to 600px before the drag gaps get any extra space
                HorizontalLayout {
                    horizontal-stretch: 6;
                    min-width: root.center-min;
                    max-width: 600px;
                    IconCell {
                        commands: "M7.5 2.5 L4 6 L7.5 9.5";
                        enabled: root.can-back;
                        clicked => { root.back(); }
                    }
                    IconCell {
                        commands: "M4.5 2.5 L8 6 L4.5 9.5";
                        enabled: root.can-forward;
                        clicked => { root.forward(); }
                    }
                    IconCell {
                        commands: root.loading ? "M3 3 L9 9 M9 3 L3 9" : "M9.6 4.2 A4 4 0 1 0 10 6 M10 1.5 L10 4.5 L7 4.5";
                        enabled: !root.blank;
                        clicked => { root.reload(); }
                    }
                    Rule { width: 1px; }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: addr.has-focus ? Theme.bg2 : transparent;
                        border-width: addr.has-focus ? 1px : 0px;
                        border-color: Theme.acc;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            Text {
                                text: addr.has-focus ? ">" : root.security;
                                color: addr.has-focus ? Theme.acc
                                    : root.addr-puny || root.security == "http" ? Theme.warn
                                    : root.security == "blocked" || root.security == "cert" ? Theme.bad
                                    : root.security == "brx" ? Theme.acc : Theme.mid;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                clip: true;
                                addr := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    text <=> root.address;
                                    single-line: true;
                                    vertical-alignment: center;
                                    // hidden behind the host/path display until focused
                                    color: self.has-focus || root.addr-host == "" ? Theme.fg : transparent;
                                    selection-background-color: Theme.acc;
                                    selection-foreground-color: Theme.bg0;
                                    text-cursor-width: 1px;
                                    accepted => {
                                        root.submit(self.text);
                                    }
                                    edited => {
                                        root.selected = 0;
                                        root.edited(self.text);
                                    }
                                    key-pressed(e) => {
                                        if (e.text == Key.Escape) {
                                            root.page-focus();
                                            return accept;
                                        }
                                        if (e.text == Key.DownArrow && root.suggestions.length > 0) {
                                            root.selected = Math.min(root.selected + 1, root.suggestions.length - 1);
                                            return accept;
                                        }
                                        if (e.text == Key.UpArrow && root.suggestions.length > 0) {
                                            root.selected = Math.max(root.selected - 1, 0);
                                            return accept;
                                        }
                                        if (e.text == Key.Tab && root.suggestions.length > 0) {
                                            root.complete(root.selected);
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }
                                if !addr.has-focus && root.addr-host != "": Rectangle {
                                    HorizontalLayout {
                                        alignment: start;
                                        Text {
                                            text: root.addr-host;
                                            color: Theme.fg;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.addr-rest;
                                            color: Theme.mid;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    TouchArea {
                                        mouse-cursor: text;
                                        clicked => {
                                            addr.focus();
                                            addr.select-all();
                                        }
                                    }
                                }
                                if root.address == "" && !addr.has-focus: Text {
                                    x: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: "url or search";
                                    color: Theme.mid;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                    }
                }
                Rule { width: 1px; }
                drag2 := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 16px;
                }
                right-group := HorizontalLayout {
                    Rule { width: 1px; }
                    Rectangle {
                        width: shield-label.preferred-width + 24px;
                        background: root.panel-open ? Theme.bg2 : (shield-ta.has-hover ? Theme.bg1 : transparent);
                        animate background { duration: 80ms; }
                        shield-label := HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: root.shield-on ? (root.narrow ? "" : "shield") : "shield off";
                                color: !root.shield-on ? Theme.bad : (root.panel-open ? Theme.fg : Theme.mid);
                                vertical-alignment: center;
                            }
                            if root.shield-on: Text {
                                text: root.shield-count;
                                color: Theme.acc;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        shield-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-panel(); }
                        }
                    }
                    menu-btn := IconCell {
                        commands: "M2 3.5 L10 3.5 M2 6.5 L10 6.5 M2 9.5 L10 9.5";
                        background: root.menu-open ? Theme.bg2 : (self.hovered ? Theme.bg1 : transparent);
                        clicked => { root.menu-toggle(); }
                    }
                    Rule { width: root.controls ? 1px : 0px; }
                    WinButton {
                        show: root.controls;
                        window-active: root.window-active;
                        commands: "M0 5.5 L10 5.5";
                        clicked => { root.win-minimize(); }
                    }
                    max-btn := WinButton {
                        show: root.controls;
                        hot: root.max-hot;
                        window-active: root.window-active;
                        commands: root.zoomed ? "M0.5 2.5 L7.5 2.5 L7.5 9.5 L0.5 9.5 Z M2.5 2.5 L2.5 0.5 L9.5 0.5 L9.5 7.5 L7.5 7.5" : "M0.5 0.5 L9.5 0.5 L9.5 9.5 L0.5 9.5 Z";
                        clicked => { root.win-maximize(); }
                    }
                    WinButton {
                        show: root.controls;
                        danger: true;
                        window-active: root.window-active;
                        commands: "M0 0 L10 10 M10 0 L0 10";
                        clicked => { root.win-close(); }
                    }
                }
            }
        }
        if root.eph: Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: 1px;
            background: Theme.acc;
        }
        Rectangle {
            x: 0;
            y: 32px;
            width: root.width;
            height: 1px;
            background: Theme.bg3;
            if root.loading: Rectangle {
                x: 0;
                width: parent.width * Math.max(0.04, Math.min(root.progress, 1.0));
                height: 1px;
                background: root.window-active ? Theme.acc : Theme.mid;
            }
        }

        // ======================================================= suggestions
        if root.show-sugg: Rectangle {
            x: 0;
            y: root.bar-h;
            width: root.width;
            height: root.sugg-h;
            background: Theme.bg0;
            VerticalLayout {
                for s[i] in root.suggestions: Rectangle {
                    height: root.row-h;
                    background: i == root.selected ? Theme.bg2 : (row-ta.has-hover ? Theme.bg1 : Theme.bg0);
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.bg3; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        Rectangle {
                            width: 44px;
                            background: i == root.selected ? Theme.acc : transparent;
                            Text {
                                text: s.tag;
                                color: i == root.selected ? Theme.bg0 : Theme.mid;
                                font-weight: i == root.selected ? 700 : 400;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: s.text;
                            color: Theme.fg;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: s.note;
                            color: Theme.mid;
                            vertical-alignment: center;
                        }
                    }
                    row-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected = i;
                            root.complete(i);
                            root.submit(root.address);
                        }
                    }
                }
                if root.strip-preview != "": Rectangle {
                    height: root.row-h;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.bg3; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        Text {
                            width: 44px;
                            text: "strip";
                            color: Theme.acc;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.strip-preview;
                            color: Theme.mid;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.strip-note;
                            color: Theme.mid;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ========================================================= blank tab
        if root.blank: Rectangle {
            x: 0;
            y: root.content-y;
            width: root.content-w;
            height: root.content-h;
            background: Theme.bg0;
            HorizontalLayout {
                x: 24px;
                y: parent.height - self.preferred-height - 24px;
                width: min(parent.width - 48px, 720px);
                height: self.preferred-height;
                spacing: 24px;
                for col in [
                    [["ctrl+l", "address"], ["ctrl+k", "commands"], ["ctrl+t", "new tab"], ["ctrl+w", "close tab"], ["ctrl+1..9", "jump to tab"]],
                    [["ctrl+b", "shield panel"], ["ctrl+h", "history"], ["ctrl+,", "settings"], ["alt+t", "next theme"], ["esc", "focus page"]]
                ]: VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;
                    Rule { height: 1px; }
                    for row in col: HorizontalLayout {
                        height: 12px;
                        Text { width: 100px; text: row[0]; color: Theme.acc; }
                        Text { text: row[1]; color: Theme.fg; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;
                    alignment: start;
                    Rule { height: 1px; }
                    Text {
                        height: 12px;
                        text: root.eph ? "ephemeral" : "recently closed";
                        color: Theme.mid;
                    }
                    if root.eph: Text {
                        text: "nothing from this window is written to disk. closing it erases cookies, cache and history.";
                        color: Theme.mid;
                        wrap: word-wrap;
                    }
                    if !root.eph && root.recent.length == 0: Text { height: 12px; text: "nothing yet"; color: Theme.mid; }
                    if !root.eph: VerticalLayout {
                        spacing: 10px;
                        for r[k] in root.recent: Rectangle {
                            height: 12px;
                            Text {
                                width: parent.width;
                                text: r;
                                color: rr.has-hover ? Theme.acc : Theme.fg;
                                overflow: elide;
                            }
                            rr := TouchArea { mouse-cursor: pointer; clicked => { root.reopen-recent(k); } }
                        }
                    }
                }
            }
        }

        // ==================================================== internal pages
        if root.page == 1: HistoryView {
            x: 0;
            y: root.content-y;
            width: root.content-w;
            height: root.content-h;
            rows: root.hist-rows;
            note: root.hist-note;
            query <=> root.hist-query;
            search(q) => { root.hist-search(q); }
            open(i) => { root.hist-open(i); }
            forget(i) => { root.hist-forget(i); }
            clear-all => { root.hist-clear(); }
        }
        if root.page == 2: SettingsView {
            x: 0;
            y: root.content-y;
            width: root.content-w;
            height: root.content-h;
            sections: root.set-sections;
            section: root.set-section;
            rows: root.set-rows;
            theme-names: root.theme-names;
            theme-acc: root.theme-acc;
            theme-bg: root.theme-bg;
            theme-mid: root.theme-mid;
            theme-index: root.theme-index;
            pick-section(i) => { root.set-section-pick(i); }
            set(k, v) => { root.set-value(k, v); }
            pick-theme(i) => { root.set-theme-pick(i); }
        }

        // ============================================================ panel
        if root.panel-open: Rectangle {
            x: root.content-w;
            y: root.content-y;
            width: 361px;
            height: root.content-h;
            background: Theme.bg0;
            Rule { x: 0; width: 1px; height: parent.height; }
            VerticalLayout {
                x: 1px;
                width: 360px;
                Rectangle {
                    height: 32px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            horizontal-stretch: 1;
                            text: "SHIELD";
                            font-weight: 700;
                            letter-spacing: 1px;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            y: 6px;
                            height: 20px;
                            width: toggle.preferred-width + 2px;
                            border-width: 1px;
                            border-color: Theme.bg3;
                            toggle := HorizontalLayout {
                                padding: 1px;
                                Cell {
                                    text: "on";
                                    pad: 8px;
                                    min-w: 0px;
                                    fg: root.shield-on ? Theme.bg0 : Theme.mid;
                                    background: root.shield-on ? Theme.acc : transparent;
                                    clicked => { root.set-shield(true); }
                                }
                                Cell {
                                    text: "off";
                                    pad: 8px;
                                    min-w: 0px;
                                    fg: root.shield-on ? Theme.mid : Theme.bg0;
                                    background: root.shield-on ? transparent : Theme.acc;
                                    clicked => { root.set-shield(false); }
                                }
                            }
                        }
                    }
                }
                Rule { height: 1px; }
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: "this tab · " + root.panel-host; color: Theme.mid; }
                    for l in root.layers: HorizontalLayout {
                        height: 18px;
                        spacing: 10px;
                        Rectangle {
                            width: 18px;
                            background: Theme.mid;
                            Text { text: l.letter; color: Theme.bg0; font-weight: 700; }
                        }
                        Text { horizontal-stretch: 1; text: l.label; color: Theme.fg; vertical-alignment: center; }
                        Text { text: l.count; color: Theme.acc; font-weight: 700; vertical-alignment: center; }
                    }
                }
                Rule { height: 1px; }
                Text {
                    text: "recent";
                    color: Theme.mid;
                    height: 30px;
                    vertical-alignment: center;
                    x: 12px;
                }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    VerticalLayout {
                        alignment: start;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 9px;
                        for e in root.log: HorizontalLayout {
                            height: 12px;
                            spacing: 10px;
                            Text { width: 18px; text: e.letter; color: Theme.mid; }
                            Text {
                                horizontal-stretch: 1;
                                text: e.subject + e.detail;
                                color: Theme.fg;
                                overflow: elide;
                            }
                        }
                    }
                }
                Rule { height: 1px; }
                Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text { horizontal-stretch: 1; text: root.session-short; color: Theme.mid; vertical-alignment: center; overflow: elide; }
                        Text { text: "ctrl+b close"; color: Theme.mid; vertical-alignment: center; }
                    }
                }
            }
        }

        // =========================================================== footer
        if root.footer-h > 0: Rectangle {
            x: 0;
            y: root.height - root.footer-h;
            width: root.width;
            height: root.footer-h;
            background: Theme.bg0;
            Rule { y: 0; height: 1px; width: parent.width; }
            HorizontalLayout {
                y: 1px;
                height: parent.height - 1px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 20px;
                Text {
                    horizontal-stretch: 1;
                    text: root.show-sugg ? "enter go    up/down pick    tab complete    esc back to page" : root.session-line;
                    color: Theme.mid;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text { text: root.footer-right; color: Theme.mid; vertical-alignment: center; }
            }
        }
    }
}
