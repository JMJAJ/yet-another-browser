// brxswer chrome. Flat: no radius, no shadow, no gradient, 1px borders,
// one monospace size, 80ms colour snaps only.

export global Theme {
    in-out property <color> bg0: #0a0a0a;
    in-out property <color> bg1: #141414;
    in-out property <color> bg2: #1e1e1e;
    in-out property <color> bg3: #282828;
    in-out property <color> fg: #e8e8e8;
    in-out property <color> acc: #ffffff;
    in-out property <color> mid: #a0a0a0;
    in-out property <color> dim: #606060;
    // muted semantic tones: state only, never decoration
    in-out property <color> ok: #8fa68b;
    in-out property <color> info: #8597aa;
    in-out property <color> warn: #b5a07a;
    in-out property <color> bad: #bc8888;
    in-out property <string> name: "eclipse";
    in-out property <string> font: "Consolas";
}

export struct TabItem { label: string, active: bool, loading: bool }
export struct LayerRow { letter: string, label: string, count: string }
export struct LogRow { letter: string, subject: string, detail: string }
export struct Suggestion { tag: string, text: string, note: string }

component Rule inherits Rectangle {
    background: Theme.bg3;
}

component Cell inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <color> fg: Theme.fg;
    in property <length> pad: 12px;
    in property <length> min-w: 32px;
    callback clicked;
    width: max(root.min-w, label.preferred-width + 2 * root.pad);
    background: root.active ? Theme.bg2 : (ta.has-hover && root.enabled ? Theme.bg1 : transparent);
    animate background { duration: 80ms; }
    label := Text {
        text: root.text;
        color: root.enabled ? root.fg : Theme.dim;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 1px stroke icon in a 32px bar cell (12x12 viewbox).
component IconCell inherits Rectangle {
    in property <string> commands;
    in property <bool> enabled: true;
    callback clicked;
    width: 32px;
    background: ta.has-hover && root.enabled ? Theme.bg1 : transparent;
    animate background { duration: 80ms; }
    Path {
        x: (parent.width - 12px) / 2;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.commands;
        stroke: root.enabled ? Theme.fg : Theme.dim;
        stroke-width: 1px;
        fill: transparent;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Window control: 46x32, glyph in a 10x10 viewbox. `hot` lets the OS drive
// hover for the maximize cell, whose events arrive as non-client messages.
component WinButton inherits Rectangle {
    in property <string> commands;
    in property <bool> danger;
    in property <bool> hot;
    in property <bool> show: true;
    in property <bool> window-active: true;
    callback clicked;
    property <bool> lit: (ta.has-hover || root.hot) && root.show;
    width: root.show ? 46px : 0px;
    clip: true;
    background: root.lit ? (root.danger ? Theme.bad : Theme.bg2) : transparent;
    animate background { duration: 80ms; }
    Path {
        x: (parent.width - 10px) / 2;
        y: (parent.height - 10px) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.commands;
        stroke: root.lit && root.danger ? Theme.bg0 : (root.window-active ? Theme.fg : Theme.mid);
        stroke-width: 1px;
        fill: transparent;
    }
    ta := TouchArea {
        enabled: root.show;
        clicked => { root.clicked(); }
    }
}

component TabCell inherits Rectangle {
    in property <TabItem> item;
    in property <bool> window-active: true;
    callback clicked;
    width: label.preferred-width + 22px;
    // the accent marks only the window that has the keyboard
    background: root.item.active ? (root.window-active ? Theme.acc : Theme.bg3) : (ta.has-hover ? Theme.bg1 : transparent);
    animate background { duration: 80ms; }
    label := Text {
        text: root.item.label;
        color: root.item.active ? (root.window-active ? Theme.bg0 : Theme.fg) : Theme.mid;
        font-weight: root.item.active ? 700 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    // loading marker: 1px line along the cell's bottom edge
    if root.item.loading && !root.item.active: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.mid;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    in property <string> win-title: "brxswer";
    title: root.win-title;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 480px;
    min-height: 240px;
    background: Theme.bg0;
    default-font-family: Theme.font;
    default-font-size: 12px;

    // ----------------------------------------------------------- state in
    in property <[TabItem]> tabs;
    in-out property <string> address;
    in property <string> security;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> loading;
    in property <float> progress;
    in property <string> shield-count: "0";
    in property <bool> panel-open;
    in property <bool> shield-on: true;
    in property <string> panel-host;
    in property <[LayerRow]> layers;
    in property <[LogRow]> log;
    in property <string> session-line;
    in property <string> session-short;
    in property <string> footer-right;
    in property <[Suggestion]> suggestions;
    in property <string> strip-preview;
    in property <string> strip-note;
    in-out property <int> selected;
    in property <bool> blank: true;
    // title bar
    in property <bool> controls;
    in property <bool> zoomed;
    in property <bool> window-active: true;
    in property <bool> max-hot;

    // ---------------------------------------------------------- events out
    callback submit(string);
    callback edited(string);
    callback tab-clicked(int);
    callback new-tab();
    callback back();
    callback forward();
    callback reload();
    callback toggle-panel();
    callback cycle-theme();
    callback set-shield(bool);
    callback page-focus();
    callback complete(int);
    callback shortcut(string, bool, bool, bool) -> bool;
    callback geometry-changed();
    callback win-minimize();
    callback win-maximize();
    callback win-close();

    // ----------------------------------------------------------- geometry
    property <length> bar-h: 33px;
    property <length> row-h: 29px;
    out property <bool> address-focused: addr.has-focus;
    property <bool> show-sugg: addr.has-focus && root.suggestions.length > 0;
    property <length> sugg-h: root.show-sugg ? (root.suggestions.length + (root.strip-preview != "" ? 1 : 0)) * root.row-h : 0px;
    property <length> footer-h: (root.blank || root.show-sugg) ? 25px : 0px;
    out property <length> content-y: root.bar-h + root.sugg-h;
    out property <length> content-w: root.width - (root.panel-open ? 361px : 0px);
    out property <length> content-h: max(0px, root.height - root.content-y - root.footer-h);
    changed content-y => { root.geometry-changed(); }
    changed content-w => { root.geometry-changed(); }
    changed content-h => { root.geometry-changed(); }

    // Regions the OS hit-tests: empty bar space drags the window, the
    // maximize cell answers as the native maximize button (snap layouts).
    out property <length> drag1-x: drag1.absolute-position.x;
    out property <length> drag1-w: drag1.width;
    out property <length> drag2-x: drag2.absolute-position.x;
    out property <length> drag2-w: drag2.width;
    out property <length> max-x: max-btn.absolute-position.x;
    out property <length> max-w: max-btn.width;
    changed drag1-x => { root.geometry-changed(); }
    changed drag2-x => { root.geometry-changed(); }
    changed drag2-w => { root.geometry-changed(); }

    public function focus-address() {
        addr.focus();
        addr.select-all();
    }

    // Keyboard focus moved into the page (a native child window).
    public function blur-address() {
        addr.clear-focus();
    }

    FocusScope {
        capture-key-pressed(e) => {
            if (e.modifiers.control || e.modifiers.alt || e.text == Key.F5) {
                if (root.shortcut(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift)) {
                    return accept;
                }
            }
            return reject;
        }

        // =============================================================== bar
        // One row that is also the title bar:
        //   tabs | drag | back fwd reload address | drag | status | window controls
        Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: 32px;
            HorizontalLayout {
                for t[i] in root.tabs: TabCell {
                    item: t;
                    window-active: root.window-active;
                    clicked => { root.tab-clicked(i); }
                }
                Cell {
                    text: "+";
                    fg: Theme.mid;
                    pad: 11px;
                    clicked => { root.new-tab(); }
                }
                drag1 := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 16px;
                }
                Rule { width: 1px; }
                // grows to 600px before the drag gaps get any extra space
                HorizontalLayout {
                    horizontal-stretch: 6;
                    min-width: 260px;
                    max-width: 600px;
                    IconCell {
                        commands: "M7.5 2.5 L4 6 L7.5 9.5";
                        enabled: root.can-back;
                        clicked => { root.back(); }
                    }
                    IconCell {
                        commands: "M4.5 2.5 L8 6 L4.5 9.5";
                        enabled: root.can-forward;
                        clicked => { root.forward(); }
                    }
                    IconCell {
                        commands: root.loading ? "M3 3 L9 9 M9 3 L3 9" : "M9.6 4.2 A4 4 0 1 0 10 6 M10 1.5 L10 4.5 L7 4.5";
                        enabled: !root.blank;
                        clicked => { root.reload(); }
                    }
                    Rule { width: 1px; }
                    Rectangle {
                        horizontal-stretch: 1;
                        background: addr.has-focus ? Theme.bg2 : transparent;
                        border-width: addr.has-focus ? 1px : 0px;
                        border-color: Theme.acc;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            Text {
                                text: addr.has-focus ? ">" : root.security;
                                color: addr.has-focus ? Theme.acc : (root.security == "http" ? Theme.warn : Theme.mid);
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                clip: true;
                                addr := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    text <=> root.address;
                                    single-line: true;
                                    vertical-alignment: center;
                                    color: Theme.fg;
                                    selection-background-color: Theme.acc;
                                    selection-foreground-color: Theme.bg0;
                                    text-cursor-width: 1px;
                                    accepted => {
                                        root.submit(self.text);
                                    }
                                    edited => {
                                        root.selected = 0;
                                        root.edited(self.text);
                                    }
                                    key-pressed(e) => {
                                        if (e.text == Key.Escape) {
                                            root.page-focus();
                                            return accept;
                                        }
                                        if (e.text == Key.DownArrow && root.suggestions.length > 0) {
                                            root.selected = Math.min(root.selected + 1, root.suggestions.length - 1);
                                            return accept;
                                        }
                                        if (e.text == Key.UpArrow && root.suggestions.length > 0) {
                                            root.selected = Math.max(root.selected - 1, 0);
                                            return accept;
                                        }
                                        if (e.text == Key.Tab && root.suggestions.length > 0) {
                                            root.complete(root.selected);
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }
                                if root.address == "" && !addr.has-focus: Text {
                                    x: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: "url or search";
                                    color: Theme.mid;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                }
                            }
                        }
                    }
                }
                Rule { width: 1px; }
                drag2 := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 16px;
                }
                Rule { width: 1px; }
                Rectangle {
                    width: shield-label.preferred-width + 24px;
                    background: root.panel-open ? Theme.bg2 : (shield-ta.has-hover ? Theme.bg1 : transparent);
                    animate background { duration: 80ms; }
                    shield-label := HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: root.shield-on ? "shield" : "shield off";
                            color: !root.shield-on ? Theme.bad : (root.panel-open ? Theme.fg : Theme.mid);
                            vertical-alignment: center;
                        }
                        if root.shield-on: Text {
                            text: root.shield-count;
                            color: Theme.acc;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    shield-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-panel(); }
                    }
                }
                Rule { width: 1px; }
                Cell {
                    text: Theme.name;
                    fg: Theme.mid;
                    clicked => { root.cycle-theme(); }
                }
                Rule { width: root.controls ? 1px : 0px; }
                WinButton {
                    show: root.controls;
                    window-active: root.window-active;
                    commands: "M0 5.5 L10 5.5";
                    clicked => { root.win-minimize(); }
                }
                max-btn := WinButton {
                    show: root.controls;
                    hot: root.max-hot;
                    window-active: root.window-active;
                    commands: root.zoomed ? "M0.5 2.5 L7.5 2.5 L7.5 9.5 L0.5 9.5 Z M2.5 2.5 L2.5 0.5 L9.5 0.5 L9.5 7.5 L7.5 7.5" : "M0.5 0.5 L9.5 0.5 L9.5 9.5 L0.5 9.5 Z";
                    clicked => { root.win-maximize(); }
                }
                WinButton {
                    show: root.controls;
                    danger: true;
                    window-active: root.window-active;
                    commands: "M0 0 L10 10 M10 0 L0 10";
                    clicked => { root.win-close(); }
                }
            }
        }
        Rectangle {
            x: 0;
            y: 32px;
            width: root.width;
            height: 1px;
            background: Theme.bg3;
            if root.loading: Rectangle {
                x: 0;
                width: parent.width * Math.max(0.04, Math.min(root.progress, 1.0));
                height: 1px;
                background: root.window-active ? Theme.acc : Theme.mid;
            }
        }

        // ======================================================= suggestions
        if root.show-sugg: Rectangle {
            x: 0;
            y: root.bar-h;
            width: root.width;
            height: root.sugg-h;
            background: Theme.bg0;
            VerticalLayout {
                for s[i] in root.suggestions: Rectangle {
                    height: root.row-h;
                    background: i == root.selected ? Theme.bg2 : (row-ta.has-hover ? Theme.bg1 : Theme.bg0);
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.bg3; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        Rectangle {
                            width: 44px;
                            background: i == root.selected ? Theme.acc : transparent;
                            Text {
                                text: s.tag;
                                color: i == root.selected ? Theme.bg0 : Theme.mid;
                                font-weight: i == root.selected ? 700 : 400;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: s.text;
                            color: Theme.fg;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: s.note;
                            color: Theme.mid;
                            vertical-alignment: center;
                        }
                    }
                    row-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected = i;
                            root.complete(i);
                            root.submit(root.address);
                        }
                    }
                }
                if root.strip-preview != "": Rectangle {
                    height: root.row-h;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.bg3; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        Text {
                            width: 44px;
                            text: "strip";
                            color: Theme.acc;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.strip-preview;
                            color: Theme.mid;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.strip-note;
                            color: Theme.mid;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ========================================================= blank tab
        if root.blank: Rectangle {
            x: 0;
            y: root.content-y;
            width: root.content-w;
            height: root.content-h;
            background: Theme.bg0;
            HorizontalLayout {
                x: 24px;
                y: parent.height - self.preferred-height - 24px;
                width: 640px;
                height: self.preferred-height;
                spacing: 24px;
                for col in [
                    [["ctrl+l", "address"], ["ctrl+t", "new tab"], ["ctrl+w", "close tab"], ["ctrl+1..9", "jump to tab"], ["ctrl+tab", "next tab"]],
                    [["alt+left", "back"], ["ctrl+r", "reload"], ["ctrl+b", "shield panel"], ["alt+t", "next theme"], ["esc", "focus page"]]
                ]: VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;
                    Rule { height: 1px; }
                    for row in col: HorizontalLayout {
                        height: 12px;
                        Text { width: 120px; text: row[0]; color: Theme.acc; }
                        Text { text: row[1]; color: Theme.fg; }
                    }
                }
            }
        }

        // ============================================================ panel
        if root.panel-open: Rectangle {
            x: root.content-w;
            y: root.content-y;
            width: 361px;
            height: root.content-h;
            background: Theme.bg0;
            Rule { x: 0; width: 1px; height: parent.height; }
            VerticalLayout {
                x: 1px;
                width: 360px;
                Rectangle {
                    height: 32px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            horizontal-stretch: 1;
                            text: "SHIELD";
                            font-weight: 700;
                            letter-spacing: 1px;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            y: 6px;
                            height: 20px;
                            width: toggle.preferred-width + 2px;
                            border-width: 1px;
                            border-color: Theme.bg3;
                            toggle := HorizontalLayout {
                                padding: 1px;
                                Cell {
                                    text: "on";
                                    pad: 8px;
                                    min-w: 0px;
                                    fg: root.shield-on ? Theme.bg0 : Theme.mid;
                                    background: root.shield-on ? Theme.acc : transparent;
                                    clicked => { root.set-shield(true); }
                                }
                                Cell {
                                    text: "off";
                                    pad: 8px;
                                    min-w: 0px;
                                    fg: root.shield-on ? Theme.mid : Theme.bg0;
                                    background: root.shield-on ? transparent : Theme.acc;
                                    clicked => { root.set-shield(false); }
                                }
                            }
                        }
                    }
                }
                Rule { height: 1px; }
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: "this tab · " + root.panel-host; color: Theme.mid; }
                    for l in root.layers: HorizontalLayout {
                        height: 18px;
                        spacing: 10px;
                        Rectangle {
                            width: 18px;
                            background: Theme.mid;
                            Text { text: l.letter; color: Theme.bg0; font-weight: 700; }
                        }
                        Text { horizontal-stretch: 1; text: l.label; color: Theme.fg; vertical-alignment: center; }
                        Text { text: l.count; color: Theme.acc; font-weight: 700; vertical-alignment: center; }
                    }
                }
                Rule { height: 1px; }
                Text {
                    text: "recent";
                    color: Theme.mid;
                    height: 30px;
                    vertical-alignment: center;
                    x: 12px;
                }
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    VerticalLayout {
                        alignment: start;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 9px;
                        for e in root.log: HorizontalLayout {
                            height: 12px;
                            spacing: 10px;
                            Text { width: 18px; text: e.letter; color: Theme.mid; }
                            Text {
                                horizontal-stretch: 1;
                                text: e.subject + e.detail;
                                color: Theme.fg;
                                overflow: elide;
                            }
                        }
                    }
                }
                Rule { height: 1px; }
                Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text { horizontal-stretch: 1; text: root.session-short; color: Theme.mid; vertical-alignment: center; overflow: elide; }
                        Text { text: "ctrl+b close"; color: Theme.mid; vertical-alignment: center; }
                    }
                }
            }
        }

        // =========================================================== footer
        if root.footer-h > 0: Rectangle {
            x: 0;
            y: root.height - root.footer-h;
            width: root.width;
            height: root.footer-h;
            background: Theme.bg0;
            Rule { y: 0; height: 1px; width: parent.width; }
            HorizontalLayout {
                y: 1px;
                height: parent.height - 1px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 20px;
                Text {
                    horizontal-stretch: 1;
                    text: root.show-sugg ? "enter go    up/down pick    tab complete    esc back to page" : root.session-line;
                    color: Theme.mid;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text { text: root.footer-right; color: Theme.mid; vertical-alignment: center; }
            }
        }
    }
}
